{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "*": ["./*"],
      "@leetcode/shared": ["../../packages/shared/src"],
      "@leetcode/database": ["../../packages/database/src"],
      "@leetcode/problem-engine": ["../../packages/problem-engine/src"],
      "@leetcode/ai": ["../../packages/ai/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}