# Cấu hình chung cho toàn monorepo — copy thành .env và sửa khi cần
# Server
PORT=3000
HOST=0.0.0.0
API_URL=http://localhost:3000

# Web (Vite yêu cầu prefix VITE_)
VITE_API_URL=http://localhost:3000

# Extension (dùng khi build, content.js gọi trực tiếp server)
EXTENSION_API_URL=http://localhost:3000
