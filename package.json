{
  "name": "leetcode-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "LeetCode learning journey monorepo",
  "scripts": {
    "web": "pnpm --filter=@leetcode/web dev",
    "server": "pnpm --filter=@leetcode/server dev",
    "dev": "concurrently \"pnpm web\" \"pnpm server\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@vitest/ui": "^4.1.11",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.0",
    "vitest": "^2.1.9"
  }
}